# Python virtual environments & bytecode
.venv/
env/
__pycache__/
*.pyc

# Large raw raster and CSV dataset files (regenerated locally or pulled from Earth Engine)
kenya_monthly_ingest/*.tif
kenya_monthly_ingest/kenya_*.csv
!kenya_monthly_ingest/kenya_county_mapping.csv
kenya_monthly_ingest/_elevation_lookup.*

# Ignore monolithic single parquet cache if >100MB
kenya_monthly_ingest/combined.parquet

# Track split chunked parquet files (<45MB each for GitHub compatibility)
!kenya_monthly_ingest/combined_part*.parquet

# Secrets & Local Configurations
.streamlit/secrets.toml
.env